<?xml version="1.0" encoding="UTF-8"?>
<language id="rgc" name="RGC" version="2.0" _section="Sources">
  <metadata>
    <property name="mimetypes">text/x-rgc</property>
    <property name="globs">*.rg</property>
    <property name="line-comment-start">#</property>
    <property name="block-comment-start">/*</property>
    <property name="block-comment-end">*/</property>
  </metadata>
  <styles>
    <style id="comment" _name="Comment" map-to="def:comment"/>
    <style id="string" _name="String" map-to="def:string"/>
    <style id="number" _name="Number" map-to="def:number"/>
    <style id="keyword" _name="Keyword" map-to="def:keyword"/>
    <style id="declaration" _name="Declaration" map-to="def:declaration"/>
    <style id="type" _name="Type" map-to="def:type"/>
    <style id="builtin" _name="Builtin" map-to="def:builtin"/>
    <style id="constant" _name="Constant" map-to="def:constant"/>
    <style id="borrow" _name="Borrow" map-to="def:special-char"/>
    <style id="operator" _name="Operator" map-to="def:operator"/>
    <style id="todo" _name="Todo" map-to="def:todo"/>
  </styles>
  <definitions>
    <context id="rgc">
      <include>
        <context ref="line-comment"/>
        <context ref="block-comment"/>
        <context ref="string"/>
        <context ref="number"/>
        <context ref="keyword"/>
        <context ref="type"/>
        <context ref="builtin"/>
        <context ref="constant"/>
        <context ref="borrow"/>
        <context ref="operator"/>
      </include>
    </context>

    <context id="line-comment" style-ref="comment" end-at-line-end="true">
      <start>#</start>
      <include>
        <context ref="todo"/>
      </include>
    </context>

    <context id="block-comment" style-ref="comment">
      <start>/\*</start>
      <end>\*/</end>
      <include>
        <context ref="todo"/>
      </include>
    </context>

    <context id="todo" style-ref="todo">
      <match>\b(TODO|FIXME|XXX|HACK|NOTE)\b</match>
    </context>

    <context id="string" style-ref="string">
      <start>"</start>
      <end>"</end>
      <escape>\</escape>
    </context>

    <context id="number" style-ref="number">
      <match>\b(0[xX][0-9a-fA-F_]+|[0-9][0-9_]*(\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?)\b</match>
    </context>

    <context id="keyword" style-ref="keyword">
      <keyword>if</keyword>
      <keyword>elif</keyword>
      <keyword>else</keyword>
      <keyword>for</keyword>
      <keyword>in</keyword>
      <keyword>while</keyword>
      <keyword>break</keyword>
      <keyword>continue</keyword>
      <keyword>pass</keyword>
      <keyword>return</keyword>
      <keyword>match</keyword>
      <keyword>case</keyword>
      <keyword>from</keyword>
      <keyword>public</keyword>
      <keyword>def</keyword>
      <keyword>class</keyword>
      <keyword>enum</keyword>
      <keyword>interface</keyword>
      <keyword>import</keyword>
      <keyword>and</keyword>
      <keyword>or</keyword>
      <keyword>not</keyword>
      <keyword>self</keyword>
    </context>

    <context id="type" style-ref="type">
      <keyword>int</keyword>
      <keyword>float</keyword>
      <keyword>bool</keyword>
      <keyword>str</keyword>
    </context>

    <context id="builtin" style-ref="builtin">
      <keyword>print</keyword>
      <keyword>range</keyword>
      <keyword>to_string</keyword>
      <keyword>args</keyword>
      <keyword>read_file</keyword>
      <keyword>write_file</keyword>
      <keyword>system</keyword>
      <keyword>len</keyword>
    </context>

    <context id="constant" style-ref="constant">
      <keyword>True</keyword>
      <keyword>False</keyword>
      <keyword>None</keyword>
    </context>

    <context id="borrow" style-ref="borrow">
      <match>@var\b|@[A-Za-z_][A-Za-z0-9_]*</match>
    </context>

    <context id="operator" style-ref="operator">
      <match>=&gt;|-&gt;|==|!=|&lt;=|&gt;=|&lt;&lt;|&gt;&gt;|\*\*|//|\+=|-=|\*=|/=|=|&lt;|&gt;|\+|-|\*|/|%|&amp;|\||\^|!</match>
    </context>
  </definitions>
</language>